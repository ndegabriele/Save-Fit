# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Model used to structure workouts (default claude-opus-5-5). claude-sonnet-5-5 is cheaper and faster.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Optional shared secret; the app sends it as EXPO_PUBLIC_APP_TOKEN.
APP_TOKEN=
# Optional Netscape cookies file so yt-dlp can read Instagram posts that need a login.
YTDLP_COOKIES=
PORT=8787
DATA_DIR=./data
